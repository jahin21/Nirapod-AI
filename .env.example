# Configure these in Render's secret/environment manager.
# Never commit the real values or a populated .env file.
DATABASE_URL=
NIRAPOD_ALLOWED_ORIGINS=https://your-flutter-web-domain.example
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-sol
GOOGLE_SAFE_BROWSING_API_KEY=
NIRAPOD_TRUST_PROXY_HEADERS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NIRAPOD_RESET_BASE_URL=

# OAuth and billing are not implemented in this release. The UI labels those
# providers as coming soon; add credentials only after implementing the flows.
